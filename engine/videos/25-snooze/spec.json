 "id":"25-snooze",
 "events":[
  ["N","What if every time you hit snooze, you slept three times longer?",{"title":1}],
  ["N","Monday, six A M. Dale has work."],
  ["X","Dale! You're going to be late!"],
  ["A",1,{"dur":0.6,"off":0.3}],
  ["N","Nine minutes. A normal snooze.",{"rung":0}],
  ["A",3,{"dur":0.6,"off":0.3}],
  ["N","Eighty one minutes. He missed the bus.",{"rung":1}],
  ["A",5,{"dur":0.6,"off":0.3}],
  ["N","Twelve hours. It's dark again.",{"rung":2}],
  ["A",7,{"dur":0.6,"off":0.3}],
  ["N","Four and a half days. Two hundred missed calls.",{"rung":3}],
  ["A",9,{"dur":0.6,"off":0.3}],
  ["N","Forty one days. The plants have taken over.",{"rung":4}],
  ["A",11,{"dur":0.6,"off":0.3}],
  ["N","One year. He slept through his own birthday.",{"rung":5}],
  ["A",13,{"dur":0.6,"off":0.3}],
  ["N","Nine years. There's a tree growing through the bed.",{"rung":6}],
  ["N","Then it got worse.",{"worse":1}],
  ["A",17,{"dur":0.7,"off":0.35}],
  ["N","Seven hundred thirty six years. He wakes up in the year twenty seven sixty two.",{"rung":7}],
  ["N","The robots are very polite about it."],
  ["I","Five more minutes."],
  ["N","The real part: the longest anyone has stayed awake on record is about eleven days, by a student in nineteen sixty four.",{"fact":1}]
